#include "sparse_gemm.h"
#include <arm_neon.h>

/* Sparse 4x4 BCC GEMM with NEON.
 * One float32x4_t accumulator holds the four adjacent output columns of
 * group g. For each stored block, the four matching inputs A[i, k0..k0+3]
 * are loaded with one vld1q_f32, and each weight row r is multiplied by
 * lane r of that vector (vfmaq_laneq_f32). Block order matches
 * gemm_sparse_scalar. */
int gemm_sparse_neon(const float *a, const sparse_weights *w, float *c, size_t m)
{
    if (!a || !w || !c)
        return SPARSE_ERROR;

    const size_t k = w->k;
    const size_t n = w->n;
    const size_t groups = n / 4;

    for (size_t i = 0; i < m; ++i) {
        const float *arow = a + i * k;
        float *crow = c + i * n;

        for (size_t g = 0; g < groups; ++g) {
            float32x4_t acc = vdupq_n_f32(0.0f);

            for (size_t p = w->block_col_ptr[g]; p < w->block_col_ptr[g + 1]; ++p) {
                const size_t k0 = 4 * (size_t)w->block_row_idx[p];
                const float *blk = w->block_values + 16 * p;

                const float32x4_t av = vld1q_f32(arow + k0);

                acc = vfmaq_laneq_f32(acc, vld1q_f32(blk + 0),  av, 0);
                acc = vfmaq_laneq_f32(acc, vld1q_f32(blk + 4),  av, 1);
                acc = vfmaq_laneq_f32(acc, vld1q_f32(blk + 8),  av, 2);
                acc = vfmaq_laneq_f32(acc, vld1q_f32(blk + 12), av, 3);
            }

            vst1q_f32(crow + 4 * g, acc);
        }
    }
    return SPARSE_OK;
}
